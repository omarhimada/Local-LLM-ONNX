<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyTitle>OLLM</AssemblyTitle>
		<ApplicationIcon>.Images\iconv1.ico</ApplicationIcon>
		<EnableGamingTargetSupport>false</EnableGamingTargetSupport>
		<RepositoryUrl>https://github.com/readydos/Local-LLM-ONNX</RepositoryUrl>
		<PackageTags>llm;ml.net;ml;ai;chat;rag;vector;onnx;local;embed</PackageTags>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<WarningsAsErrors>False</WarningsAsErrors>
		<NoWarn>NU1900</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<RestoreAdditionalProjectSources>C:\Users\iAdos\.nuget\packages</RestoreAdditionalProjectSources>
		<RestoreFallbackFolders>C:\Users\iAdos\.nuget\packages</RestoreFallbackFolders>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	</PropertyGroup>

	<PropertyGroup>
		<BuildDateUtc>$([System.DateTime]::UtcNow.ToString("yyyyMMdd"))</BuildDateUtc>
		<BuildTimeUtc>$([System.DateTime]::UtcNow.ToString("HHmmss"))</BuildTimeUtc>
		<BuildTimeMonthUtc>$([System.DateTime]::UtcNow.ToString("MM"))</BuildTimeMonthUtc>
		<BuildTimeSecondsUtc>$([System.DateTime]::UtcNow.ToString("ss"))</BuildTimeSecondsUtc>
		<DynamicVersionPart>$(BuildDateUtc).$(BuildTimeUtc)</DynamicVersionPart>
		<VersionPrefix>1.0</VersionPrefix>
		<Version>$(VersionPrefix).$(BuildTimeMonthUtc).$(BuildTimeSecondsUtc)</Version>
		<AssemblyVersion>$(VersionPrefix).$(BuildTimeMonthUtc).$(BuildTimeSecondsUtc)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="10.2\**" />
		<Compile Remove="12.9\**" />
		<Compile Remove="13.1\**" />
		<Compile Remove="SD\CUDA\**" />
		<Compile Remove="SD\Native\**" />
		<Compile Remove="SD\Parameters\**" />
		<EmbeddedResource Remove="10.2\**" />
		<EmbeddedResource Remove="12.9\**" />
		<EmbeddedResource Remove="13.1\**" />
		<EmbeddedResource Remove="SD\CUDA\**" />
		<EmbeddedResource Remove="SD\Native\**" />
		<EmbeddedResource Remove="SD\Parameters\**" />
		<None Remove="10.2\**" />
		<None Remove="12.9\**" />
		<None Remove="13.1\**" />
		<None Remove="SD\CUDA\**" />
		<None Remove="SD\Native\**" />
		<None Remove="SD\Parameters\**" />
		<Page Remove="10.2\**" />
		<Page Remove="12.9\**" />
		<Page Remove="13.1\**" />
		<Page Remove="SD\CUDA\**" />
		<Page Remove="SD\Native\**" />
		<Page Remove="SD\Parameters\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="learn_attempt_2.cs" />
		<Compile Remove="Utility\ModelSpecific\CodeGemma.cs" />
		<Compile Remove="Utility\ModelSpecific\Mistral.cs" />
		<Compile Remove="Utility\ModelSpecific\QwenCoder.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="cublasLt64_12.dll" />
		<None Remove="cudnn64_9.dll" />
		<None Remove="e_sqlite3.dll" />
		<None Remove="Fonts\0xProto-Regular.ttf" />
		<None Remove="Fonts\overpass-mono-bold.otf" />
		<None Remove="Fonts\overpass-mono-light.otf" />
		<None Remove="Fonts\overpass-mono-regular.otf" />
		<None Remove="Fonts\overpass-mono-semibold.otf" />
		<None Remove="learn_attempt_0.txt" />
		<None Remove="learn_attempt_1.txt" />
		<None Remove="vec0.dll" />
	</ItemGroup>

	<ItemGroup>
		<Content Include=".Images\iconv1.ico" />

		<!-- Exclude .pdb files from publish output -->
		<Content Update="**\*.pdb" CopyToPublishDirectory="Never" />

		<!-- Include Embed model in the executable (it's small) -->
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\config.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\model.onnx">
		</Content>
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\special_tokens_map.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\tokenizer.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\tokenizer_config.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="ONNX\Embed\All-MiniLM-L6-v2-ONNX\vocab.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Fonts\0xProto-Regular.ttf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Fonts\overpass-mono-bold.otf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Fonts\overpass-mono-light.otf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Fonts\overpass-mono-regular.otf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Fonts\overpass-mono-semibold.otf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference NoWarn="NU1900" Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-preview.1.26104.118" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.Extensions.AI" Version="10.3.0" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.1.26104.118" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.24.2" />
		<PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.12.1" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.SemanticKernel.Connectors.SqliteVec" Version="1.72.0-preview" />
		<PackageReference NoWarn="NU1900" Include="Microsoft.SemanticKernel.Core" Version="1.72.0" />
		<PackageReference NoWarn="NU1900" Include="System.Management" Version="11.0.0-preview.1.26104.118" />
	</ItemGroup>

	<ItemGroup>
		<None Update="ONNX\gpt-oss-20b\config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\gpt-oss-20b\genai_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\gpt-oss-20b\model.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="ONNX\gpt-oss-20b\model.onnx.data">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="ONNX\gpt-oss-20b\special_tokens_map.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\gpt-oss-20b\tokenizer.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\gpt-oss-20b\tokenizer_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\feature_extractor\preprocessor_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\model_index.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\scheduler\scheduler_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\text_encoder\config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\text_encoder\model.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\tokenizer\merges.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\tokenizer\special_tokens_map.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\tokenizer\tokenizer_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\tokenizer\vocab.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\unet\config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\unet\model.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\vae_decoder\config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\vae_decoder\model.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\vae_encoder\config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="ONNX\SD\0nnX00Aammnpdxebr\vae_encoder\model.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
	</ItemGroup>

	<!-- Do not include native PDBs and .lib in published release (for simplicity and UX cleanliness) -->
	<Target Name="RemoveNativePDBs" AfterTargets="ComputeFilesToPublish">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
		</ItemGroup>
	</Target>
</Project>